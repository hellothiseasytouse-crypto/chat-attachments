{
  "rewrites": [
    { "source": "/api/chat", "destination": "https://noxenlabs.vercel.app/api/chat" },
    { "source": "/api/image", "destination": "https://noxenlabs.vercel.app/api/image" },
    { "source": "/api/images", "destination": "https://noxenlabs.vercel.app/api/images" },
    { "source": "/api/inspect", "destination": "https://noxenlabs.vercel.app/api/inspect" },
    { "source": "/api/youtube", "destination": "https://noxenlabs.vercel.app/api/youtube" },
    { "source": "/api/media", "destination": "https://noxenlabs.vercel.app/api/media" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
