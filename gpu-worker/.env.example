# Use a long random value. Keep this secret.
WORKER_API_KEY=replace-with-a-long-random-secret

# Studio Plus starter: choose a DeepSeek checkpoint compatible with the available GPU.
# Example: deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
MODEL_ID=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# Kimi K2/K3 are enormous MoE checkpoints. Set MODEL_ID only after confirming
# that the selected AirLLM release supports that exact checkpoint and the free
# GPU session has enough disk, RAM, and bandwidth.
# Kimi K2 instruct checkpoint: moonshotai/Kimi-K2-Instruct
# Kimi K3 checkpoint: verify the exact official model repository before use.
# MODEL_ID=moonshotai/Kimi-K2-Instruct

MAX_INPUT_TOKENS=4096
MAX_NEW_TOKENS=768
AIRLLM_COMPRESSION=4bit
AIRLLM_DELETE_ORIGINAL=false
